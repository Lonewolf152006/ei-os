# ── Neon PostgreSQL ──
DATABASE_URL=

# ── Anthropic (powers Lemma agents) ──
ANTHROPIC_API_KEY=

# ── Lemma SDK (local orchestration) ──
# Get via: lemma auth login → copy token
LEMMA_API_KEY=
LEMMA_API_URL=http://localhost:8711

# ── OpenRouter (optional fallback) ──
OPENROUTER_API_KEY=

# ─── Auto-fetch configuration ─────────────────────────────
# These let EI-OS pull live data instead of using dropped files.
# All are optional — the system falls back to data/ files if unset.
# FETCH_SINCE_HOURS controls how far back each fetch looks.

FETCH_SINCE_HOURS=24

# GitHub — generate at github.com/settings/tokens (needs: repo)
GITHUB_TOKEN=
GITHUB_REPO=Lonewolf152006/supabase

# Slack — create app at api.slack.com
# Required scopes: channels:history, channels:read
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0BDMLGCZRBs

# Complaints source: freshdesk | zendesk | none
COMPLAINTS_SOURCE=none
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=
